# Base URL of the Cinder & Salt API (cinder-salt-api), including the version
# prefix. Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Where the guest ordering portal gets its data. Only "mock" exists until the
# ordering API (Phase 3A) is live.
NEXT_PUBLIC_ORDERING_DATA_SOURCE=mock
